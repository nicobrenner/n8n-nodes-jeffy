{
  "name": "Customer Support Routing with Jeffy",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "responseMode": "responseNode"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "classify",
        "task": "banking77",
        "text": "={{ $json.body.message }}"
      },
      "name": "Classify Intent",
      "type": "n8n-nodes-jeffy.jeffy",
      "typeVersion": 1,
      "position": [470, 300],
      "credentials": {
        "jeffyApi": {
          "id": "1",
          "name": "Jeffy API"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.label }}",
                    "rightValue": "terminate_account",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "Retention"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.label }}",
                    "rightValue": "lost_or_stolen_card",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": "Urgent"
            }
          ],
          "fallbackOutput": {
            "renameOutput": "General"
          }
        }
      },
      "name": "Route by Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [690, 300]
    },
    {
      "parameters": {
        "channel": "#retention-team",
        "text": "=🚨 Account cancellation request\n\nCustomer message: {{ $('Webhook').item.json.body.message }}\n\nClassification: {{ $('Classify Intent').item.json.label }} ({{ Math.round($('Classify Intent').item.json.confidence * 100) }}% confidence)",
        "otherOptions": {}
      },
      "name": "Notify Retention",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [910, 180]
    },
    {
      "parameters": {
        "channel": "#urgent-support",
        "text": "=🔴 Lost/stolen card report\n\nCustomer message: {{ $('Webhook').item.json.body.message }}\n\nClassification: {{ $('Classify Intent').item.json.label }} ({{ Math.round($('Classify Intent').item.json.confidence * 100) }}% confidence)",
        "otherOptions": {}
      },
      "name": "Notify Urgent",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "channel": "#general-support",
        "text": "=📋 Support ticket\n\nCustomer message: {{ $('Webhook').item.json.body.message }}\n\nClassification: {{ $('Classify Intent').item.json.label }} ({{ Math.round($('Classify Intent').item.json.confidence * 100) }}% confidence)",
        "otherOptions": {}
      },
      "name": "Notify General",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [910, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'routed', intent: $('Classify Intent').item.json.label, confidence: $('Classify Intent').item.json.confidence }) }}"
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1130, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Classify Intent", "type": "main", "index": 0 }]
      ]
    },
    "Classify Intent": {
      "main": [
        [{ "node": "Route by Intent", "type": "main", "index": 0 }]
      ]
    },
    "Route by Intent": {
      "main": [
        [{ "node": "Notify Retention", "type": "main", "index": 0 }],
        [{ "node": "Notify Urgent", "type": "main", "index": 0 }],
        [{ "node": "Notify General", "type": "main", "index": 0 }]
      ]
    },
    "Notify Retention": {
      "main": [
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    },
    "Notify Urgent": {
      "main": [
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    },
    "Notify General": {
      "main": [
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
